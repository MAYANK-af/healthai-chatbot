# Google Authentication (OAuth 2.0) Configuration
# (Optional: Leave empty if not using Google Auth login)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Telegram Bot Integration for Medical Adherence Alerts & Clinical Exports
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Override Telegram API endpoint (e.g. for self-hosted proxies)
# TELEGRAM_API_URL=https://api.telegram.org
